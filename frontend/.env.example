# Ejemplo de configuración. Copia este archivo a `.env.local` y ajusta los valores.
# `.env.local` está ignorado por git y tiene prioridad sobre `.env`.

# ----------------------------------------------------------------------
# URL base del backend ProApp.
#
# Déjala vacía para desarrollo local: Vite redirige /api/* a
# http://localhost:8080 a través del proxy configurado en vite.config.ts.
#
# Pon una URL absoluta para apuntar a un backend remoto (frontend en tu
# máquina, backend en otro servidor):
#
#   VITE_API_URL=http://192.168.1.20:8080
#   VITE_API_URL=https://api.mi-dominio.com
#
# Tras cambiarla, reinicia `npm run dev` o rehaz el build con `npm run build`.
# ----------------------------------------------------------------------

VITE_API_URL=