# Ejemplo de configuración del backend. Copia a `.env` (ignorado por git).
# El binario carga este archivo al arrancar. Variables de entorno del shell
# tienen prioridad sobre los valores de .env.

# ----------------------------------------------------------------------
# OAuth con Google — REQUERIDO. Crea un OAuth Client ID de tipo "Web
# application" en https://console.cloud.google.com/ bajo tu proyecto.
# Scopes: openid, email, profile (non-sensitive, no requieren verificación).
# Authorized redirect URIs debe incluir EXACTAMENTE el valor de
# GOOGLE_REDIRECT_URL de aquí (Google hace match de string exacto).
#
# Google NO acepta http:// salvo en localhost / 127.0.0.1. Para
# producción en dominio real, usa HTTPS.
# ----------------------------------------------------------------------
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ----------------------------------------------------------------------
# Allowlist de emails — REQUERIDO. Lista separada por comas de los
# únicos correos que pueden iniciar sesión. Vacío = nadie entra.
# Se compara en minúsculas. Cualquier email fuera de esta lista es
# rechazado en el callback (no se crea usuario ni sesión).
# ----------------------------------------------------------------------
ALLOWED_EMAILS=realprosl.tecnico@gmail.com

# ----------------------------------------------------------------------
# Emails que obtienen role='admin' en su PRIMER login. Tras la creación,
# el rol solo cambia editando la BD manualmente (permite promover/
# degradar sin reiniciar el servidor). Déjalo vacío para que todos
# los autenticados sean 'user' (read-only).
# ----------------------------------------------------------------------
ADMIN_EMAILS=realprosl.tecnico@gmail.com

# ----------------------------------------------------------------------
# A dónde redirigir al usuario tras un login exitoso. En dev con Vite
# puede ser http://localhost:5173 (la cookie se emite desde el proxy).
# En prod con backend sirviendo el dist, usa "/" o la URL externa.
# ----------------------------------------------------------------------
FRONTEND_URL=/

# Duración de la sesión en horas. Default 24.
# SESSION_TTL_HOURS=24

# Cookie Secure (solo se envía sobre HTTPS). Default true. Ponlo false
# solo si despliegas por HTTP en LAN — la cookie NO viajará si el
# frontend accede por https aunque el backend esté en http.
# COOKIE_SECURE=true
